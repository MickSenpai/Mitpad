{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mitpad": {
      "type": "local",
      "command": ["pnpm", "--dir", "mitpad", "run", "mcp"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "MITPAD_CONVEX_SITE_URL": "https://brave-walrus-170.convex.site",
        "MITPAD_AGENT_API_KEY": "{file:~/.config/mitpad/agent_api_key}"
      }
    }
  }
}
